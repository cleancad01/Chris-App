# Required: Anthropic API key for Help-me and end-of-lesson reports.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: hosted transcription (OpenAI Whisper API). If unset, local Whisper (transformers.js) is used.
# OPENAI_API_KEY=sk-...

# Optional: override the data folder (default: %APPDATA%/tutor-copilot/data on Windows).
# TUTOR_DATA_DIR=C:\Users\you\TutorCopilotData

# Optional: use a fake audio source that replays bundled sample audio (for testing without a mic).
# TUTOR_MOCK_AUDIO=1

# Optional: fake model answers (no API cost) for testing the UI.
# TUTOR_MOCK_LLM=1

# Optional: force a transcriber: local (Whisper in-app, default) | hosted (OpenAI, needs OPENAI_API_KEY) | mock
# TUTOR_TRANSCRIBER=local

# Optional: Whisper model for local transcription. whisper-tiny.en is faster on slow PCs.
# TUTOR_WHISPER_MODEL=Xenova/whisper-base.en
